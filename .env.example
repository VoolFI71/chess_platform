# Обязательные переменные для базового локального запуска.
# Скопируйте этот файл в .env и замените все значения-заглушки.

# Python-сервисы используют DATABASE_URL, Go-сервисы — GO_DATABASE_URL.
DATABASE_URL=postgresql+psycopg2://chess:chess@db:5432/chess
GO_DATABASE_URL=postgresql://chess:chess@db:5432/chess?sslmode=disable

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
INTERNAL_TOKEN=replace-with-a-different-long-random-secret

# Почта нужна базовому auth-сервису: регистрация и восстановление пароля.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=ChessMint
FRONTEND_URL=http://localhost:8080
FRONTEND_RESET_PASSWORD_PATH=/reset-password

# WebSocket и OAuth.
WS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# MAILRU_OAUTH_CLIENT_ID=
# MAILRU_OAUTH_CLIENT_SECRET=
# MAILRU_OAUTH_REDIRECT_URI=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# Платежи, уведомления и задачи.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:8080
# PUZZLES_CSV_FILE_PATH=

# MinIO и доступ backend к S3-совместимому хранилищу.
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-minio-password
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_USE_SSL=false
# S3_BUCKET_VIDEOS=videos
# S3_BUCKET_ASSETS=assets

# Мониторинг.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password

# Production: используйте docker-compose.prod.yml и отдельный .env.production.
# GATEWAY_CONFIG=gateway.prod.conf
# LETSENCRYPT_DOMAIN=example.com
# LETSENCRYPT_EMAIL=admin@example.com
# GRAFANA_DOMAIN=grafana.example.com
# GRAFANA_ROOT_URL=https://grafana.example.com/

# Необязательные параметры производительности Stockfish.
# STOCKFISH_POOL_SIZE=4
# AI_DEFAULT_SKILL_LEVEL=5
# AI_DEFAULT_TIME_LIMIT_MS=2000
