# ============================================
# База данных
# ============================================
DATABASE_URL=postgresql+psycopg2://chess:chess@db:5432/chess

# ============================================
# JWT токены
# ============================================
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================
# Внутренние токены для межсервисной коммуникации
# ============================================
INTERNAL_TOKEN=your-internal-token-change-in-production
INTERNAL_API_TOKEN=your-internal-api-token-change-in-production
GAMES_INTERNAL_TOKEN=your-games-internal-token
PUZZLES_INTERNAL_TOKEN=your-puzzles-internal-token
AUTH_INTERNAL_TOKEN=your-auth-internal-token
USERS_INTERNAL_TOKEN=your-users-internal-token
COMPUTER_GAMES_INTERNAL_TOKEN=your-computer-games-internal-token

# ============================================
# URL сервисов
# ============================================
USERS_SERVICE_URL=http://users:8000
GAMES_SERVICE_URL=http://games:8000
EMAIL_SERVICE_URL=http://email:8000
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
FRONTEND_RESET_PASSWORD_PATH=/reset-password

# ============================================
# Frontend
# ============================================
WEB_DIR=backend/web

# ============================================
# SMTP настройки для отправки email
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=ChessMint
EMAIL_PROVIDER=smtp

# Альтернативные email провайдеры (опционально)
# SENDGRID_API_KEY=your-sendgrid-api-key
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ============================================
# OAuth провайдеры
# ============================================
# Mail.ru OAuth
MAILRU_OAUTH_CLIENT_ID=your-mailru-client-id
MAILRU_OAUTH_CLIENT_SEC=your-mailru-client-secret

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback

# ============================================
# Платежи (YooKassa)
# ============================================
YOOKASSA_SHOP_ID=your-yookassa-shop-id
YOOKASSA_SECRET_KEY=your-yookassa-secret-key

# ============================================
# Object Storage (MinIO / S3) - опционально
# ============================================
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your-s3-access-key
# S3_SECRET_KEY=your-s3-secret-key
# S3_USE_SSL=false
# S3_BUCKET_VIDEOS=videos
# S3_BUCKET_ASSETS=assets
MINIO_ROOT_USER=chessmint
MINIO_ROOT_PASSWORD=your-minio-password

# ============================================
# Go сервисы - специфичные настройки
# ============================================
# Games Service
# PORT=8000 (по умолчанию)
WS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://yourdomain.com

# Computer Games Service
# STOCKFISH_PATH=/usr/bin/stockfish
# STOCKFISH_POOL_SIZE=4
# AI_DEFAULT_SKILL_LEVEL=5
# AI_DEFAULT_TIME_LIMIT_MS=2000

# ============================================
# Мониторинг
# ============================================
METRICS_ENABLED=true

# ============================================
# Kafka (опционально, для асинхронных задач)
# ============================================
# KAFKA_BROKER_URL=kafka:9092

# ============================================
# Docker / Build настройки
# ============================================
COMPOSE_DOCKER_CLI_BUILD=0
DOCKER_BUILDKIT=0

# ============================================
# Let's Encrypt (для production)
# ============================================
LETSENCRYPT_DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=your-email@example.com
